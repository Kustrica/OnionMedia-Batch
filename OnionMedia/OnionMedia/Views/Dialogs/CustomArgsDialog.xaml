<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="OnionMedia.Views.Dialogs.CustomArgsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Style="{ThemeResource DefaultContentDialogStyle}"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnSaveClick">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1100</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">1000</x:Double>
    </ContentDialog.Resources>

    <ContentDialog.Title>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Custom yt-dlp parameters" VerticalAlignment="Center"/>
            <Button x:Name="helpButton" Padding="6" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="What is this?">
                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE946;" FontSize="16"/>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel MaxWidth="420" Spacing="8">
                            <TextBlock Text="Custom yt-dlp parameters" FontWeight="SemiBold"/>
                            <TextBlock TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="13"
                                       Text="These parameters are added to every yt-dlp call OnionMedia makes (reading video info and downloading)."/>
                            <TextBlock TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="13"
                                       Text="The output folder/file name, the format selection (-f) and a few internal options are managed by OnionMedia and cannot be changed here. To influence which format is chosen, use -S (format sort) – the Max Quality ceiling is still applied."/>
                            <TextBlock TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="13"
                                       Text="Write one or more options per line, use quotes for values with spaces; lines starting with # are ignored. Validate checks the syntax with yt-dlp, Test runs a simulation on the selected video."/>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </ContentDialog.Title>

    <ScrollViewer x:Name="rootScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <Grid x:Name="rootGrid" Width="900" ColumnSpacing="24" RowSpacing="0" Padding="0,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="leftColumn" Width="*"/>
                <ColumnDefinition x:Name="rightColumn" Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Left: what is applied. Parameters and Output share the height equally (same size, aligned with the catalog). -->
            <Grid x:Name="leftPanel" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ToggleSwitch x:Name="enableToggle" Header="Apply custom parameters"
                              OnContent="On – used for new fetches and downloads" OffContent="Off – saved, but not used"
                              Toggled="OnToggleChanged"/>

                <TextBox x:Name="argsBox" Grid.Row="1"
                         Header="Parameters"
                         PlaceholderText="--impersonate chrome&#x0a;--sleep-requests 1"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         FontFamily="Consolas"
                         FontSize="13"
                         MinHeight="110"
                         VerticalAlignment="Stretch"
                         IsSpellCheckEnabled="False"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         TextChanged="OnArgsTextChanged"/>

                <InfoBar x:Name="statusBar" Grid.Row="2" IsOpen="False" IsClosable="False"/>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="validateButton" Click="OnValidateClick" ToolTipService.ToolTip="Check the syntax and let yt-dlp parse the parameters">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE73E;" FontSize="14"/>
                            <TextBlock Text="Validate"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="testButton" Click="OnTestClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE768;" FontSize="14"/>
                            <TextBlock Text="Test with selected video"/>
                        </StackPanel>
                    </Button>
                    <ProgressRing x:Name="busyRing" IsActive="False" Width="20" Height="20" VerticalAlignment="Center"/>
                    <HyperlinkButton x:Name="cancelRunButton" Content="Stop" Visibility="Collapsed" Click="OnStopClick" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBox x:Name="logBox" Grid.Row="4"
                         Header="Output"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         FontSize="13"
                         MinHeight="110"
                         VerticalAlignment="Stretch"
                         PlaceholderText="Results of Validate / Test / Update appear here."
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>

            <!-- Right: catalog of popular options -->
            <Grid x:Name="rightPanel" Grid.Column="1" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Popular options" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE946;" FontSize="13" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              ToolTipService.ToolTip="Pick a value, then Copy it or Add it to Parameters. Adding an option that is already there replaces its old value."/>
                </StackPanel>
                <Border Grid.Row="1" CornerRadius="{ThemeResource OverlayCornerRadius}" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <ScrollViewer x:Name="catalogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" Height="420">
                        <StackPanel x:Name="catalogPanel" Padding="12,6,16,6"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Bottom: yt-dlp itself -->
            <Border x:Name="bottomBar" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="0,10,0,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7B8;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="versionText" Text="yt-dlp …" VerticalAlignment="Center" IsTextSelectionEnabled="True"/>
                    </StackPanel>
                    <CheckBox x:Name="autoUpdateCheck" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                              Content="Update automatically (at most once a day)"/>
                    <Button x:Name="updateButton" Grid.Column="2" Click="OnUpdateClick" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Run yt-dlp -U now (needs internet access to GitHub)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE895;" FontSize="14"/>
                            <TextBlock Text="Update yt-dlp"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</ContentDialog>
